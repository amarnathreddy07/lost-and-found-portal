{
  "$schema": "openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install --prefix server",
  "outputDirectory": "client",
  "functions": {
    "server/api/index.js": {
      "includeFiles": "client/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/server/api/index.js" }
  ]
}
